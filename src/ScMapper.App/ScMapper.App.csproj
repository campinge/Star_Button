<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ScMapper.Core\ScMapper.Core.csproj" />
    <ProjectReference Include="..\ScMapper.Platform\ScMapper.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lato (SIL OFL), the typeface of das-kartell.org -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ScMapper.App</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyName>StarButton</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StarButton.ico</ApplicationIcon>
    <NoWarn>CA1416;NETSDK1206</NoWarn>
  </PropertyGroup>

</Project>
