<Window x:Class="ScMapper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScMapper.App.Views"
        xmlns:c="clr-namespace:ScMapper.App.Controls"
        Title="Star Button" Width="1320" Height="860" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:Backdrop Grid.RowSpan="2" ShowScan="False" />
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- navigation rail -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Background>
                    <SolidColorBrush Color="{DynamicResource PanelColor}" />
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,16,26">
                        <StackPanel Orientation="Horizontal">
                            <!-- the Kartell mark (orb with ring), as on das-kartell.org -->
                            <Path Data="F1 M62.1393,10.6237 L51.8933,12.6337 C48.2002,5.59493 40.7885,0.788086 32.2471,0.788086 C20.6879,0.788086 11.1992,9.58809 10.1941,20.8138 L0.140625,22.7855 L10.1941,24.7585 C11.1979,35.9855 20.6866,44.7881 32.2471,44.7881 C40.7898,44.7881 48.2015,39.9812 51.8946,32.9425 L62.1406,34.9538 V10.6237 H62.1393 Z M17.4968,8.13417 C21.4363,4.22009 26.6748,2.06345 32.2458,2.06345 C37.8169,2.06345 43.0554,4.21881 46.9949,8.13417 C48.4326,9.56258 49.6341,11.1644 50.5814,12.8913 L11.506,20.5562 C12.0092,15.8641 14.09,11.5177 17.4955,8.13417 H17.4968 Z M46.9962,37.442 C43.0567,41.3561 37.8181,43.5127 32.2471,43.5127 C26.6761,43.5127 21.4376,41.3574 17.4981,37.442 C14.0913,34.0572 12.0105,29.7095 11.5086,25.0161 L50.5853,32.6849 C49.6379,34.4117 48.4364,36.0136 46.9988,37.442 H46.9962 Z"
                                  Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="43" Height="31" Margin="0,0,12,0"
                                  VerticalAlignment="Center" />
                            <TextBlock FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Text="STAR BUTTON" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="STICK MAPPER FOR STAR CITIZEN" Margin="0,6,0,0" />
                        <Rectangle Height="1" Margin="0,18,0,0" Fill="{DynamicResource Border2Brush}" />
                    </StackPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Flat}" FontSize="12" Margin="12,0,0,12"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="Das-Kartell.org"
                            ToolTip="https://das-kartell.org" Click="Kartell_Click" />
                    <StackPanel>
                        <RadioButton x:Name="NavSticks" Style="{StaticResource Nav}" Content="01  STICKS" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavBindings" Style="{StaticResource Nav}" Content="02  BINDINGS" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAntiAfk" Style="{StaticResource Nav}" Content="03  ANTI AFK" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="04  SETTINGS" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <v:SticksView x:Name="SticksPage" />
                <v:BindingsView x:Name="BindingsPage" Visibility="Collapsed" />
                <v:AntiAfkView x:Name="AntiAfkPage" Visibility="Collapsed" />
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <StackPanel Orientation="Horizontal" TextElement.FontSize="12">
                <Rectangle Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,10,0" />
                <TextBlock x:Name="StatusSticks" Style="{StaticResource Muted}" />
                <Rectangle Width="1" Height="12" Margin="14,0" Fill="{DynamicResource Border2Brush}" />
                <TextBlock x:Name="StatusGame" Style="{StaticResource Muted}" />
                <Rectangle Width="1" Height="12" Margin="14,0" Fill="{DynamicResource Border2Brush}" />
                <TextBlock x:Name="StatusLast" Style="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <!-- start screen: covers the whole window, nothing behind it is reachable -->
        <v:OnboardingView x:Name="Onboarding" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="100" />

        <!-- dialogs and messages: each one is a dimmed layer with a card, added here while it is open -->
        <Grid x:Name="OverlayHost" Grid.RowSpan="2" Panel.ZIndex="200" />
    </Grid>
</Window>
