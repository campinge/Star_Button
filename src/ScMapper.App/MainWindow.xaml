<Window x:Class="ScMapper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ScMapper.App.Views"
        xmlns:c="clr-namespace:ScMapper.App.Controls"
        Title="Star Button" Width="1320" Height="860" MinWidth="1100" MinHeight="680"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <c:Backdrop Grid.RowSpan="2" ShowScan="False" />
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- navigation rail -->
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource PanelColor}" Offset="0" />
                        <GradientStop Color="{DynamicResource AccentDeepColor}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,16,26">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,0 L10,5.5 L16,5.5 L11,9 L13,15 L8,11.4 L3,15 L5,9 L0,5.5 L6,5.5 Z"
                                  Fill="{DynamicResource AccentBrush}" Margin="0,2,10,0" VerticalAlignment="Center"
                                  Effect="{DynamicResource AccentGlow}" />
                            <TextBlock FontSize="19" FontWeight="Bold" Text="STAR BUTTON" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Text="STICK MAPPER // STAR CITIZEN" Margin="0,4,0,0" />
                        <Rectangle Height="1" Margin="0,16,0,0">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Margin="20,0,0,16" VerticalAlignment="Bottom" Text="STAR BUTTON // LIVE" />
                    <StackPanel>
                        <RadioButton x:Name="NavSticks" Style="{StaticResource Nav}" Content="01  STICKS" IsChecked="True" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavBindings" Style="{StaticResource Nav}" Content="02  BINDINGS" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavAntiAfk" Style="{StaticResource Nav}" Content="03  ANTI AFK" Checked="Nav_Checked" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="04  SETTINGS" Checked="Nav_Checked" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <v:SticksView x:Name="SticksPage" />
                <v:BindingsView x:Name="BindingsPage" Visibility="Collapsed" />
                <v:AntiAfkView x:Name="AntiAfkPage" Visibility="Collapsed" />
                <v:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="20,7">
            <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource MonoFont}" TextElement.FontSize="12">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource GoodBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusSticks" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Text="  //  " Foreground="{DynamicResource Border2Brush}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock x:Name="StatusGame" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Text="  //  " Foreground="{DynamicResource Border2Brush}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock x:Name="StatusLast" Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" />
            </StackPanel>
        </Border>

        <!-- start screen: covers the whole window, nothing behind it is reachable -->
        <v:OnboardingView x:Name="Onboarding" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="100" />

        <!-- dialogs and messages: each one is a dimmed layer with a card, added here while it is open -->
        <Grid x:Name="OverlayHost" Grid.RowSpan="2" Panel.ZIndex="200" />
    </Grid>
</Window>
