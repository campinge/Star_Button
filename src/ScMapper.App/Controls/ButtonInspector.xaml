<UserControl x:Class="ScMapper.App.Controls.ButtonInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls">
    <Border Style="{StaticResource Card}">
        <Grid>
            <TextBlock x:Name="Empty" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20"
                       Text="Click a button in the grid, or press it on the stick." />
            <StackPanel x:Name="Body" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="ClearAll" DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="Clear everything"
                            Click="ClearAll_Click" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock x:Name="Title" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="Rows" Margin="0,16,0,0" />
                <TextBlock x:Name="NoActions" Style="{StaticResource Muted}" Text="Nothing assigned to this button yet." Margin="0,0,0,12" />

                <Button x:Name="AddBtn" Style="{StaticResource Accent}" Content="+ Add action" HorizontalAlignment="Left"
                        MinHeight="38" Padding="18,6" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
