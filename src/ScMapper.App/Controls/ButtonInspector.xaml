<UserControl x:Class="ScMapper.App.Controls.ButtonInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls">
    <c:Card>
        <Grid>
            <TextBlock x:Name="Empty" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20"
                       Text="Click a button in the grid, or press it on the stick." />
            <StackPanel x:Name="Body" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="ClearAll" DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="Clear everything"
                            Click="ClearAll_Click" VerticalAlignment="Top" />
                    <StackPanel>
                        <TextBlock x:Name="Title" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LabelBox" MinHeight="38" VerticalContentAlignment="Center"
                             TextChanged="LabelBox_TextChanged" KeyDown="LabelBox_KeyDown"
                             ToolTip="Your own name for this button, e.g. Landing gear (Enter saves)" />
                    <TextBlock x:Name="LabelHint" Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                               Style="{StaticResource Muted}" Text="Button name (optional)" />
                    <Button x:Name="SaveLabelBtn" Grid.Column="1" Style="{StaticResource Accent}" Content="Save"
                            MinHeight="38" MinWidth="100" Margin="10,0,0,0" Click="SaveLabel_Click" />
                </Grid>

                <Border x:Name="ReplaceNotice" Margin="0,16,0,0" Padding="12,10"
                        Background="{DynamicResource WarnDimBrush}" BorderBrush="{DynamicResource WarnBrush}"
                        BorderThickness="3,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="18" VerticalAlignment="Top" Margin="0,-2,10,0"
                                   Foreground="{DynamicResource WarnBrush}" />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource WarnBrush}"
                                   Text="Adding an action will disable the functionality of the button and replace it with the selected action." />
                    </DockPanel>
                </Border>
                <StackPanel x:Name="ConflictBox" Margin="0,12,0,0" />
                <StackPanel x:Name="Rows" Margin="0,12,0,0" />
                <TextBlock x:Name="NoActions" Style="{StaticResource Muted}" Text="Nothing assigned to this button yet." Margin="0,0,0,12" />

                <Button x:Name="AddBtn" Style="{StaticResource Accent}" Content="+ Add action" HorizontalAlignment="Left"
                        MinHeight="38" Padding="18,6" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </c:Card>
</UserControl>
