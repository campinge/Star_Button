<UserControl x:Class="ScMapper.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource H1}" Text="Profiles" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,16" TextWrapping="Wrap"
                       Text="A profile is a complete setup: keyboard &amp; mouse, gamepad and every stick. Pick the active one in the Bindings tab; deploy writes it to Star Citizen." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="YOUR PROFILES" Margin="0,0,0,8" />
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button Content="New" Click="New_Click" Margin="0,0,6,6" />
                            <Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,6,6" />
                            <Button Content="Import…" Click="Import_Click" Margin="0,0,6,6" />
                            <Button Content="Export…" Click="Export_Click" Margin="0,0,6,6" />
                            <Button Content="Delete" Style="{StaticResource Danger}" Click="Delete_Click" Margin="0,0,6,6" />
                        </WrapPanel>
                        <ListBox x:Name="ProfileList" MinHeight="220" MaxHeight="420" SelectionChanged="ProfileList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="  ● active" FontSize="11" Foreground="{StaticResource GoodBrush}"
                                                       VerticalAlignment="Center" Visibility="{Binding ActiveVisibility}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="NoProfile" Style="{StaticResource Muted}" Text="Select a profile." />
                        <StackPanel x:Name="ProfileDetail" Visibility="Collapsed">
                            <TextBox x:Name="PName" FontSize="18" FontWeight="SemiBold" TextChanged="PName_TextChanged" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ActivateBtn" Content="Make active" Style="{StaticResource Accent}" Click="Activate_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="CONTENTS" Margin="0,18,0,6" />
                            <ItemsControl x:Name="Entries">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Input}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding What}" TextWrapping="Wrap"
                                                           Style="{StaticResource Muted}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Star Citizen files -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="STAR CITIZEN FILES ON THIS PC" />
                    <TextBlock x:Name="ScNote" Style="{StaticResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <ListBox x:Name="ScFiles" MaxHeight="240">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Read into a new profile" Style="{StaticResource Accent}" Click="ImportSc_Click" Margin="0,0,8,6" />
                        <Button Content="Use as actionmaps.xml (backup first)" Click="Restore_Click" Margin="0,0,8,6" />
                        <Button Content="Open folder" Click="OpenFolder_Click" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock x:Name="ScResult" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
