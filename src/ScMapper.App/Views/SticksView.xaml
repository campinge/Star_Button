<UserControl x:Class="ScMapper.App.Views.SticksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls"
             PreviewMouseDown="View_PreviewMouseDown">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- top bar: title left, stick picker right -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H1}" Text="Sticks" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="NoProfileToken" Visibility="Collapsed" Margin="0,0,12,0" Padding="10,5"
                            Background="{DynamicResource WarnDimBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="NoProfileText" Foreground="{DynamicResource WarnBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Button x:Name="ProfilesBtn" Content="Profiles" MinHeight="44" Padding="16,6" Margin="0,0,10,0"
                            Click="Profiles_Click"
                            ToolTip="Add, rename or delete profiles and choose which stick each one is on" />
                </StackPanel>
                <ComboBox x:Name="StickPicker" Grid.Column="2" Width="420" MinHeight="44" VerticalAlignment="Center"
                          SelectionChanged="StickPicker_SelectionChanged" ToolTip="Choose a profile">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="30" ToolTip="{Binding Sub}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding Dot}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{DynamicResource Panel2Brush}" Padding="7,2"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding Badge}" FontSize="12" Style="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <TextBlock x:Name="EmptyHint" Grid.Row="2" Style="{StaticResource Muted}" Margin="0,60,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top" />

            <Grid x:Name="StickPanel" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- header: everything about the stick in one block -->
                <c:Card>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameBox" FontSize="17" FontWeight="SemiBold" TextChanged="NameBox_TextChanged"
                                     KeyDown="NameBox_KeyDown" ToolTip="Name of this stick's profile (Enter saves)" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="SaveNameBtn" Style="{StaticResource Accent}" Content="Save" MinHeight="38" MinWidth="100"
                                        Click="SaveName_Click" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="RemapBox" Visibility="Collapsed" Margin="0,16,0,0" Padding="14"
                                Background="{DynamicResource WarnDimBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock x:Name="RemapText" Text="Not connected. Which device is it now?" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarnBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="RemapCombo" MinHeight="38" />
                                    <Button Grid.Column="1" Content="Assign" Style="{StaticResource Accent}" MinHeight="38" MinWidth="96"
                                            Margin="8,0,0,0" Click="RemapAssign_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </c:Card>

                <!-- live view + inspector -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <c:Card>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource H2}" Text="AXES AND HATS" Margin="0,0,0,10" />
                            <c:AxesControl x:Name="Axes" Grid.Row="1" HorizontalAlignment="Left" />
                            <DockPanel Grid.Row="2" Margin="0,0,0,0" VerticalAlignment="Top">
                                <DockPanel DockPanel.Dock="Top" Margin="0,20,0,10">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5"
                                               VerticalAlignment="Center" Text="● has a rule or binding" />
                                    <TextBlock Style="{StaticResource H2}" Text="BUTTONS" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <c:ButtonGridControl x:Name="ButtonsGrid" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </c:Card>

                    <ScrollViewer x:Name="RightScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <c:ButtonInspector x:Name="Inspector" />
                        <c:Card x:Name="EventsCard" Margin="0,16,0,0" Padding="16,10">
                            <StackPanel>
                                <Button x:Name="EventsToggle" Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                        Content="▸ RECENT EVENTS" Click="EventsToggle_Click" Padding="0,4" />
                                <StackPanel x:Name="EventsBody" Visibility="Collapsed" Margin="0,8,0,4">
                                    <ItemsControl x:Name="EventLog">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                                           Style="{StaticResource Muted}" Margin="0,1" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoEvents" Style="{StaticResource Muted}" Text="Nothing pressed yet." />
                                </StackPanel>
                            </StackPanel>
                        </c:Card>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

    </Grid>
</UserControl>
