<UserControl x:Class="ScMapper.App.Views.SticksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- top bar: title left, stick picker right -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H1}" Text="Sticks" />
                    <TextBlock x:Name="CountText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" HorizontalAlignment="Left" Content="Profile manager" MinHeight="44" Padding="16,6"
                        Margin="0,0,10,0" Click="ProfileManager_Click"
                        ToolTip="Assign a profile to each connected stick (press a button on a stick to find it)" />
                <ComboBox x:Name="StickPicker" Grid.Column="2" Width="420" MinHeight="44" VerticalAlignment="Center"
                          SelectionChanged="StickPicker_SelectionChanged" ToolTip="Choose a stick">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="30" ToolTip="{Binding Sub}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding Dot}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{StaticResource Panel2Brush}" CornerRadius="4" Padding="7,2"
                                        Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding BadgeVisibility}">
                                    <TextBlock Text="{Binding Badge}" FontSize="12" Style="{StaticResource Muted}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <TextBlock x:Name="EmptyHint" Grid.Row="1" Style="{StaticResource Muted}" Margin="0,60,0,0"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Text="Connect a joystick or press a button on one." />

            <Grid x:Name="StickPanel" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- header: everything about the stick in one block -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NameBox" FontSize="17" FontWeight="SemiBold" TextChanged="NameBox_TextChanged"
                                     ToolTip="Name of this stick" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ModelText" Style="{StaticResource Muted}" FontSize="12" Margin="2,6,0,0" />

                        <!-- rarely needed: kept out of the way. Profiles are assigned in the Profile manager. -->
                        <Button x:Name="AdvancedToggle" Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                Content="▸ Advanced" Click="AdvancedToggle_Click" Padding="0,4" Margin="0,10,0,0" />
                        <StackPanel x:Name="AdvancedBody" Visibility="Collapsed">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Star Citizen number" Margin="0,0,0,6"
                                               ToolTip="Auto = position in the DirectInput list, which is what Star Citizen uses" />
                                    <ComboBox x:Name="InstanceCombo" MinHeight="38" SelectionChanged="InstanceCombo_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="IdentifyBtn" Content="Identify" MinHeight="38" MinWidth="96" Click="Identify_Click"
                                            ToolTip="Press a button on the physical stick to link it to this entry" />
                                    <Button x:Name="ForgetBtn" Style="{StaticResource Danger}" Content="Forget" MinHeight="38" MinWidth="84"
                                            Margin="8,0,0,0" Click="Forget_Click" ToolTip="Remove this stick (its profile is kept)" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border x:Name="RemapBox" Visibility="Collapsed" Margin="0,16,0,0" Padding="14"
                                Background="#2A2210" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Not connected. Which device is it now?" FontWeight="SemiBold"
                                           Foreground="{StaticResource WarnBrush}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="RemapCombo" MinHeight="38" />
                                    <Button Grid.Column="1" Content="Assign" Style="{StaticResource Accent}" MinHeight="38" MinWidth="96"
                                            Margin="8,0,0,0" Click="RemapAssign_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CaptureHint" Visibility="Collapsed" Margin="0,12,0,0"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <!-- live view + inspector -->
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource H2}" Text="Axes and hats" Margin="0,0,0,10" />
                            <c:AxesControl x:Name="Axes" Grid.Row="1" HorizontalAlignment="Left" />
                            <DockPanel Grid.Row="2" Margin="0,0,0,0" VerticalAlignment="Top">
                                <DockPanel DockPanel.Dock="Top" Margin="0,20,0,10">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5"
                                               VerticalAlignment="Center" Text="● has a rule or binding" />
                                    <TextBlock Style="{StaticResource H2}" Text="Buttons" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <c:ButtonGridControl x:Name="ButtonsGrid" />
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <c:ButtonInspector x:Name="Inspector" />
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,10">
                            <StackPanel>
                                <Button x:Name="EventsToggle" Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                        Content="▸ Recent events" Click="EventsToggle_Click" Padding="0,4" />
                                <StackPanel x:Name="EventsBody" Visibility="Collapsed" Margin="0,8,0,4">
                                    <ItemsControl x:Name="EventLog">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5"
                                                           Style="{StaticResource Muted}" Margin="0,1" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoEvents" Style="{StaticResource Muted}" Text="Nothing pressed yet." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- unassigned device -->
            <Border x:Name="DevicePanel" Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DevTitle" Style="{StaticResource H1}" />
                    <TextBlock x:Name="DevSub" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Not linked to a saved stick yet: a new stick, or one you named before (after re-plugging)." />
                    <Button Content="Create new stick" Style="{StaticResource Accent}" MinHeight="40" HorizontalAlignment="Left"
                            Padding="20,6" Margin="0,16,0,0" Click="CreateStick_Click" />
                    <StackPanel x:Name="LinkBox" Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Or link to a saved stick" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LinkCombo" MinHeight="38" />
                            <Button Grid.Column="1" Content="Link" MinHeight="38" MinWidth="96" Margin="8,0,0,0" Click="Link_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
    </Grid>
</UserControl>
