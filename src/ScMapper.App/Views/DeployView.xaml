<UserControl x:Class="ScMapper.App.Views.DeployView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource H1}" Text="Deploy" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,16" TextWrapping="Wrap"
                       Text="Write your stick bindings into Star Citizen. Stick numbers are resolved to the current js numbers, a backup is made first, and everything else in actionmaps.xml is left alone." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="STAR CITIZEN" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="InstallCombo" Width="520"
                                  SelectionChanged="InstallCombo_SelectionChanged" />
                        <Button Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                        <Button Content="Rescan" Margin="8,0,0,0" Click="Rescan_Click" />
                    </StackPanel>
                    <TextBlock x:Name="InstallInfo" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="CatalogInfo" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Button Content="Re-read action list from game files" Margin="0,12,0,0" HorizontalAlignment="Left"
                            Click="Reload_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="WRITE BINDINGS" Margin="0,0,0,8" />
                    <TextBlock x:Name="RunWarn" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="Collapsed"
                               Text="Star Citizen is running. It may overwrite actionmaps.xml when it exits. Close the game before deploying." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Preview changes" Click="Preview_Click" />
                        <Button Content="Deploy to Star Citizen" Style="{StaticResource Accent}" Margin="8,0,0,0" Click="Deploy_Click" />
                    </StackPanel>
                    <TextBlock x:Name="Result" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <ItemsControl x:Name="Warnings" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="KEYBOARD OUTPUT" Margin="0,0,0,8" />
                    <CheckBox x:Name="OutputCheck" Content="Send keyboard output for button rules while this app is running"
                              Click="Output_Click" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Button rules (press/release → keys) only work while Star Button is running. Closing the window keeps it running in the tray." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
