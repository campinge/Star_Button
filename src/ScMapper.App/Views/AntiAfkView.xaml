<UserControl x:Class="ScMapper.App.Views.AntiAfkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls">
    <UserControl.Resources>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Margin" Value="0,16,0,0" />
            <Setter Property="Padding" Value="0,16,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,20" MaxWidth="960" HorizontalAlignment="Stretch">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource H1}" Text="Anti AFK" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                           Text="Taps W, A, S, D one after the other at random intervals, so the character walks in a circle" />
            </StackPanel>

            <c:Card x:Name="Warning" Margin="0,0,0,16" Background="{DynamicResource WarnDimBrush}"
                    BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarnBrush}"
                               Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="WarnTitle" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource WarnBrush}"
                                   Text="Star Citizen has to be in focus" />
                        <TextBlock x:Name="WarnText" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                                   Text="The keys only reach the game while its window is in front. Taps are skipped while it is in the background." />
                    </StackPanel>
                </StackPanel>
            </c:Card>

            <c:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <c:AfkDial x:Name="Dial" Width="330" Height="330" Margin="0,0,28,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="State" Text="Stopped" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="LastTap" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFont}" Text="No tap yet" />

                        <Button x:Name="Toggle" Content="Start" Style="{StaticResource Accent}" HorizontalAlignment="Left"
                                Margin="0,20,0,0" MinHeight="46" MinWidth="150" Click="Toggle_Click" />

                        <Border Style="{StaticResource RowLine}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="Time between taps" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Random value in this range, in seconds" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="MinBox" Width="64" MinHeight="38" Text="20" TextChanged="Interval_Changed"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                    <TextBlock Text="to" Style="{StaticResource Muted}" Margin="10,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="MaxBox" Width="64" MinHeight="38" Text="60" TextChanged="Interval_Changed"
                                             VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </c:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
