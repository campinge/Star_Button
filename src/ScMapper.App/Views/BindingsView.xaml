<UserControl x:Class="ScMapper.App.Views.BindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls">
    <UserControl.Resources>

        <!-- One binding as a chip: device badge, input, optional trigger-mode badge. Lights up while the input is held. -->
        <DataTemplate x:Key="TagTemplate">
            <Border x:Name="tag" Padding="8,5" Margin="0,3,8,3" BorderThickness="1" Cursor="Hand"
                    Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    MouseLeftButtonDown="Tag_MouseDown" Tag="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="badge" Padding="5,1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="kind" Text="{Binding Kind}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                    <TextBlock x:Name="val" Text="{Binding Text}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border x:Name="modeBadge" Visibility="{Binding ModeVisibility}" Padding="6,1"
                            Margin="8,0,0,0" Background="{DynamicResource AccentDimBrush}" VerticalAlignment="Center">
                        <TextBlock x:Name="modeText" Text="{Binding ModeLabel}" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <Button x:Name="rm" Content="✕" Tag="{Binding}" Click="TagRemove_Click" Style="{StaticResource Flat}"
                            Padding="5,0" Margin="6,0,-4,0" FontSize="10" Opacity="0" VerticalAlignment="Center"
                            Foreground="{DynamicResource MutedBrush}" ToolTip="Remove this binding" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="tag" Property="IsMouseOver" Value="True">
                    <Setter TargetName="rm" Property="Opacity" Value="1" />
                    <Setter TargetName="tag" Property="BorderBrush" Value="{DynamicResource Border2Brush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Kind}" Value="KB">
                    <Setter TargetName="badge" Property="Background" Value="#1B2D4A" />
                    <Setter TargetName="kind" Property="Foreground" Value="#6FA8FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="PAD">
                    <Setter TargetName="badge" Property="Background" Value="#1B3A2C" />
                    <Setter TargetName="kind" Property="Foreground" Value="#5FD08F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="JS">
                    <Setter TargetName="badge" Property="Background" Value="#3E3115" />
                    <Setter TargetName="kind" Property="Foreground" Value="#F0B64A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter TargetName="tag" Property="Opacity" Value="0.45" />
                    <Setter TargetName="tag" Property="ToolTip" Value="This stick is not plugged in: the binding is kept but not deployed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                    <Setter TargetName="tag" Property="Opacity" Value="0.6" />
                    <Setter TargetName="tag" Property="Background" Value="Transparent" />
                    <Setter TargetName="tag" Property="ToolTip" Value="Game default - click to change how it triggers" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="tag" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="tag" Property="Opacity" Value="1" />
                    <Setter TargetName="tag" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Lit}" Value="True">
                    <Setter TargetName="tag" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="tag" Property="BorderBrush" Value="White" />
                    <Setter TargetName="tag" Property="Opacity" Value="1" />
                    <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentDeepBrush}" />
                    <Setter TargetName="kind" Property="Foreground" Value="White" />
                    <Setter TargetName="val" Property="Foreground" Value="Black" />
                    <Setter TargetName="modeBadge" Property="Background" Value="{DynamicResource AccentDeepBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One choice in the trigger-mode dropdown of the side panel (title only; the description is shown below it) -->
        <DataTemplate x:Key="ModeTemplate">
            <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,3" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Header, two rows: actions on top, the full status line below. -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="8,6" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SetupCombo" Width="190" ToolTip="Active profile" SelectionChanged="SetupCombo_SelectionChanged" />
                    <Button x:Name="SetupMenuBtn" Grid.Column="1" Style="{StaticResource Flat}" Content="⋯" Padding="9,4"
                            Margin="2,0,0,0" ToolTip="Profile actions" Click="SetupMenu_Click" FontSize="16">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SetupMenu">
                                <MenuItem x:Name="MenuSave" Header="Save changes" Click="SetupSave_Click" />
                                <MenuItem Header="Save as new profile…" Click="SetupSaveAs_Click" />
                                <MenuItem x:Name="MenuRevert" Header="Discard unsaved changes" Click="SetupRevert_Click" />
                                <Separator />
                                <MenuItem Header="New empty profile…" Click="SetupNew_Click" />
                                <MenuItem x:Name="MenuRename" Header="Rename…" Click="SetupRename_Click" />
                                <Separator />
                                <MenuItem Header="Export to file…" Click="SetupExport_Click" />
                                <MenuItem Header="Import from file…" Click="SetupImport_Click" />
                                <Separator />
                                <MenuItem Header="Joystick numbers (js1, js2, …)…" Click="JsNumbers_Click"
                                          ToolTip="Which number Star Citizen uses for each stick; swap two numbers" />
                                <Separator />
                                <MenuItem x:Name="MenuDelete" Header="Delete" Click="SetupDelete_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button x:Name="SaveBtn" Grid.Column="2" Content="💾 Save" Style="{StaticResource Accent}" Margin="8,0,0,0"
                            Padding="10,5" Visibility="Collapsed" Click="SetupSave_Click"
                            ToolTip="This profile has unsaved changes - save them (⋯ for “Save as new profile…”)" />

                    <Grid Grid.Column="3" Margin="14,0,0,0">
                        <TextBox x:Name="Search" TextChanged="Filter_Changed" Padding="8,5,30,5" />
                        <TextBlock x:Name="SearchHint" Text="Search actions…" IsHitTestVisible="False" Margin="11,0,0,0"
                                   VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        <Button x:Name="SearchClear" Content="✕" Style="{StaticResource Flat}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,3,0" Padding="6,2" FontSize="11"
                                Foreground="{DynamicResource MutedBrush}" ToolTip="Clear search" Visibility="Collapsed"
                                Click="SearchClear_Click" />
                    </Grid>

                    <Button x:Name="ReadBtn" Grid.Column="4" Content="⟳ Read SC" Margin="14,0,0,0" Padding="10,5" Click="Read_Click"
                            ToolTip="Replace this profile's bindings with what Star Citizen currently has" />
                    <Grid Grid.Column="5" Margin="6,0,0,0">
                        <Button x:Name="DeployBtn" Content="⇪ Deploy" Style="{StaticResource Accent}"
                                Padding="10,5" Click="Deploy_Click" ToolTip="Write this profile to Star Citizen" />
                        <!-- Not part of the button, so it stays fully visible while Deploy is greyed out. -->
                        <Ellipse x:Name="DeployAlarm" Width="12" Height="12" Fill="{DynamicResource BadBrush}"
                                 Stroke="{DynamicResource BgBrush}" StrokeThickness="2" HorizontalAlignment="Right"
                                 VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <TextBlock x:Name="SyncStatus" Margin="2,8,0,0" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />

                <!-- a stick's bindings sit under another js number in the game's file than the stick has now -->
                <Border x:Name="JsDriftBox" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8"
                        Background="{DynamicResource WarnDimBrush}" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="JsDriftText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource WarnBrush}" />
                        <Button Grid.Column="1" Content="Joystick numbers…" Padding="12,4" Margin="12,0,0,0"
                                Click="JsNumbers_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Left: actions. Doppelklick = bind, Klick auf einen Chip = Details rechts. -->
        <DockPanel Grid.Row="1">
            <TextBlock x:Name="CatalogStatus" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11"
                       Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                       Text="Double-click an action to bind a key or stick button (hold two keys for a combination, Esc cancels). Click a chip to change how it triggers." />
            <ListBox x:Name="Tree" SelectionChanged="Tree_SelectionChanged" MouseDoubleClick="Tree_DoubleClick"
                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <!-- No gap between rows, so the guide lines run unbroken. -->
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Guide lines (Reddit style): one per ancestor; click = collapse that ancestor. -->
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Border x:Name="g0" Width="18" Background="Transparent" Cursor="Hand" Tag="0"
                                    Visibility="{Binding Guide0Visibility}" ToolTip="{Binding Guide0Tip}"
                                    MouseLeftButtonDown="Guide_MouseDown">
                                <Rectangle x:Name="g0l" Width="2" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="g1" Width="18" Background="Transparent" Cursor="Hand" Tag="1"
                                    Visibility="{Binding Guide1Visibility}" ToolTip="{Binding Guide1Tip}"
                                    MouseLeftButtonDown="Guide_MouseDown">
                                <Rectangle x:Name="g1l" Width="2" Fill="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <Border x:Name="row" Grid.Column="1" Padding="12,9" BorderThickness="3,0,0,0"
                                BorderBrush="Transparent" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="150" />
                                    <ColumnDefinition Width="1.7*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" Width="18" Foreground="{DynamicResource MutedBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Grid.ColumnSpan="{Binding TitleSpan}" VerticalAlignment="Center">
                                    <TextBlock x:Name="title" Text="{Binding Text}" FontSize="{Binding TitleSize}"
                                               FontWeight="{Binding Weight}" Foreground="{Binding Fore}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="prompt" Visibility="Collapsed" Margin="0,5,0,0" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                               Text="Press a key or stick button · hold two to combine · Esc cancels" />
                                </StackPanel>
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagTemplate}"
                                              Visibility="{Binding TagsVisibility}" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Grid.Column="2" Text="not bound" Style="{StaticResource Muted}" FontSize="12"
                                           FontStyle="Italic" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding NoneVisibility}" />
                                <Border x:Name="count" Grid.Column="3" Visibility="{Binding CountVisibility}"
                                        Background="{DynamicResource Panel2Brush}" Padding="9,2"
                                        Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}" x:Name="countText" />
                                </Border>
                            </Grid>
                        </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="g0" Property="IsMouseOver" Value="True">
                                <Setter TargetName="g0l" Property="Fill" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger SourceName="g1" Property="IsMouseOver" Value="True">
                                <Setter TargetName="g1l" Property="Fill" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Kind}" Value="0">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Panel2Brush}" />
                                <Setter TargetName="row" Property="Margin" Value="0,8,0,2" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="2">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource PanelBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasBound}" Value="True">
                                <Setter TargetName="count" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                <Setter TargetName="countText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Capturing}" Value="True">
                                <Setter TargetName="prompt" Property="Visibility" Value="Visible" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Lit}" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentDeepBrush}" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="count" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="countText" Property="Foreground" Value="Black" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Right: details of the selected chip. Only there while a chip is selected. -->
        <c:Card x:Name="Panel" Grid.Row="1" Grid.Column="1" Width="340" Margin="14,0,0,0" Visibility="Collapsed" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Flat}" Click="PanelClose_Click"
                                ToolTip="Close" Padding="6,2" />
                        <TextBlock Style="{StaticResource H2}" Text="BINDING" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="PanelAction" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="PanelPath" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" />

                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PanelInput" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PanelSource" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource H2}" Text="HOW SHOULD IT TRIGGER?" Margin="0,18,0,6" />
                    <ComboBox x:Name="ModeList" ItemTemplate="{StaticResource ModeTemplate}" MinHeight="34"
                              HorizontalAlignment="Stretch" SelectionChanged="ModeList_SelectionChanged" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{Binding SelectedItem.Description, ElementName=ModeList}" />
                    <TextBlock x:Name="PanelModeNote" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <StackPanel Margin="0,18,0,0">
                        <Button Content="Bind a different input…" Click="PanelRebind_Click" HorizontalAlignment="Stretch"
                                ToolTip="Press the new key or stick button for this action" />
                        <Button Content="Remove this binding" Style="{StaticResource Danger}" Click="PanelRemove_Click"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </c:Card>
    </Grid>
</UserControl>
