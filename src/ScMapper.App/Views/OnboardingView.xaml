<UserControl x:Class="ScMapper.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ScMapper.App.Controls"
             Background="{DynamicResource BgBrush}">
    <!-- Full-window start screen, shown while there is no profile at all. Nothing behind it can be reached until
         it is left. It only explains how the app works; the profiles are made for the sticks when it is left. -->
    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="0.8">
                <GradientStop Color="#0E2A3C" Offset="0" />
                <GradientStop Color="#060A0F" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <!-- faint grid, like a navigation display -->
        <Rectangle IsHitTestVisible="False" Opacity="0.55">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,56,56" ViewportUnits="Absolute"
                              Viewbox="0,0,56,56" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Geometry="M0,0 L56,0 M0,0 L0,56">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#10283A" Thickness="1" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- one slow scan line -->
        <Rectangle Height="2" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.35">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#004FD6FF" Offset="0" />
                    <GradientStop Color="#FF4FD6FF" Offset="0.5" />
                    <GradientStop Color="#004FD6FF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="Scan" />
            </Rectangle.RenderTransform>
            <Rectangle.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Scan" Storyboard.TargetProperty="Y"
                                             From="-10" To="1200" Duration="0:0:11" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Rectangle.Triggers>
        </Rectangle>

        <Grid x:Name="ExplainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="900" Margin="0,40,0,30" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M8,0 L10,5.5 L16,5.5 L11,9 L13,15 L8,11.4 L3,15 L5,9 L0,5.5 L6,5.5 Z"
                              Fill="{DynamicResource AccentBrush}" Margin="0,2,10,0" VerticalAlignment="Center" />
                        <TextBlock FontSize="19" FontWeight="Bold" Text="STAR BUTTON" />
                        <TextBlock Style="{StaticResource Muted}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,2,0,0" Text="//  JOYSTICK LINK  ·  ONLINE" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontFamily="{StaticResource MonoFont}" Margin="0,40,0,0"
                               Foreground="{DynamicResource AccentBrush}" Text="//  WELCOME, PILOT" />
                    <TextBlock FontSize="34" FontWeight="SemiBold" Margin="0,6,0,0" Text="How Star Button works">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#4FD6FF" BlurRadius="22" ShadowDepth="0" Opacity="0.35" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <Rectangle Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Width="260">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF4FD6FF" Offset="0" />
                                <GradientStop Color="#004FD6FF" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Style="{StaticResource Muted}" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Star Button sits between your joysticks and Star Citizen. It remembers what every button of your sticks should do." />

                    <Grid x:Name="Flow" Margin="0,40,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" x:Name="Box1">
                            <!-- resting box -->
                            <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                            <!-- lights up while the signal passes, behind the text -->
                            <Border x:Name="Box1Glow" Opacity="0" IsHitTestVisible="False" BorderThickness="2"
                                    Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBrush}" />
                            <Border Padding="22,20">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="YOUR STICK" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="You press a button." />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Height="22">
                            <Rectangle Height="2" Fill="{DynamicResource Border2Brush}" Margin="0,0,8,0" />
                            <Path Data="M0,0 L9,6 L0,12" Stroke="{DynamicResource Border2Brush}" StrokeThickness="2"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Rectangle x:Name="Line1" Height="2" Fill="{DynamicResource AccentBrush}" Opacity="0"
                                       HorizontalAlignment="Left" Width="0" Margin="0,0,8,0" />
                            <Ellipse x:Name="Dot1" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Opacity="0"
                                     HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid Grid.Column="2" x:Name="Box2">
                            <!-- resting box -->
                            <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                            <!-- lights up while the signal passes, behind the text -->
                            <Border x:Name="Box2Glow" Opacity="0" IsHitTestVisible="False" BorderThickness="2"
                                    Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBrush}" />
                            <Border Padding="22,20">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Foreground="{DynamicResource AccentBrush}" Text="PROFILE" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="Remembers what each button does." />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="3" Margin="10,0" VerticalAlignment="Center" Height="22">
                            <Rectangle Height="2" Fill="{DynamicResource Border2Brush}" Margin="0,0,8,0" />
                            <Path Data="M0,0 L9,6 L0,12" Stroke="{DynamicResource Border2Brush}" StrokeThickness="2"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <Rectangle x:Name="Line2" Height="2" Fill="{DynamicResource AccentBrush}" Opacity="0"
                                       HorizontalAlignment="Left" Width="0" Margin="0,0,8,0" />
                            <Ellipse x:Name="Dot2" Width="12" Height="12" Fill="{DynamicResource AccentBrush}" Opacity="0"
                                     HorizontalAlignment="Left">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <Grid Grid.Column="4" x:Name="Box3">
                            <!-- resting box -->
                            <Border Background="{DynamicResource Panel2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                            <!-- lights up while the signal passes, behind the text -->
                            <Border x:Name="Box3Glow" Opacity="0" IsHitTestVisible="False" BorderThickness="2"
                                    Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBrush}" />
                            <Border Padding="22,20">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="STAR CITIZEN" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="Gets the keys and bindings." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- three plain sentences: what the user needs to know and nothing more -->
                    <StackPanel Margin="0,36,0,0">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource H1}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" Text="01" />
                            <TextBlock Grid.Column="1" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Every stick gets a profile of its own. Star Button makes them for you, named after the stick." />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource H1}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" Text="02" />
                            <TextBlock Grid.Column="1" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Your settings are saved in the profile, not in the stick. If a stick breaks or you buy a new one, you give the profile to the new stick and nothing is lost." />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource H1}" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource AccentBrush}" Text="03" />
                            <TextBlock Grid.Column="1" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="You can rename profiles or hand them to another stick at any time with the Profiles button on the Sticks page." />
                        </Grid>
                    </StackPanel>

                    <!-- what is plugged in right now: these get a profile when the button is pressed -->
                    <c:Card Margin="0,34,0,0" Padding="20,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                         Margin="0,0,10,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2"
                                                                     Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock x:Name="FoundTitle" Style="{StaticResource H2}" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="FoundList" Margin="0,8,0,0" />
                            <TextBlock x:Name="FoundNote" Style="{StaticResource Muted}" FontSize="14.5" TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,16">
                <DockPanel Width="900" HorizontalAlignment="Center">
                    <Button x:Name="StartBtn" DockPanel.Dock="Right" Content="Continue" Style="{StaticResource Accent}"
                            MinHeight="48" MinWidth="190" Padding="24,6" Click="Start_Click" IsDefault="True" />
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
